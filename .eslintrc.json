{
  "extends": [
    "next/core-web-vitals",
    "@rocketseat/eslint-config/react"
  ],
  "plugins": ["prettier"],
  "rules": {
    "camelcase": "off",
    "no-unused-vars": "off",
    "@typescript-eslint/no-explicit-any": ["off"],
    "endOfLine": "off",
    "react/no-unescaped-entities": "off",
    "@next/next/no-page-custom-font": "off",
  }
}
